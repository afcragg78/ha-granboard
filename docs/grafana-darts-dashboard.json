      "id": 1,
      "type": "timeseries",
      "title": "3-Dart Average",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#00e5ff"
          },
          "unit": "none",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "SELECT last(\"value\") FROM /^sensor\\.${board}_.*_3_dart_average$/ WHERE $timeFilter AND \"player\" =~ /^$player$/ GROUP BY time($__interval), \"player\" fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "policy": "default",
          "refId": "A",
          "hide": false
        }
      ]
